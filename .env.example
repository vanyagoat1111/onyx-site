# ВНИМАНИЕ: переменные с префиксом VITE_ Vite зашивает в публичный JS-бандл
# сайта — их видит любой посетитель через "Просмотр кода страницы". Поэтому
# сюда нельзя класть секреты (токены ботов, пароли, приватные ключи API).
# Токен Telegram-бота должен храниться только на сервере, а не во фронтенде.

# Эндпоинт приёма заявок (имя + телефон).
# ЛОКАЛИЗАЦИЯ ПДн (152-ФЗ, ст. 18 ч. 5): указывайте здесь РФ-эндпоинт —
# webhook на российском хостинге (Yandex Cloud / Selectel / Timeweb / Reg.ru),
# Яндекс Формы или свой VPS в РФ. НЕ используйте Google Apps Script / Google
# Forms для боевого приёма ПДн: их серверы за рубежом.
VITE_LEADS_ENDPOINT_URL=https://your-ru-hosted-endpoint.example/lead

# Устаревшая переменная (обратная совместимость). Используется, только если
# VITE_LEADS_ENDPOINT_URL не задана. Для боевого приёма ПДн не применять.
VITE_LEADS_GOOGLE_SCRIPT_URL=

# Номер WhatsApp для кнопки связи на сайте. Только цифры, с кодом страны.
# Если не задать, используется номер по умолчанию из src/lib/leads.ts.
VITE_WHATSAPP_PHONE=79223767525

# ── CRM (onyx-web.ru/#crm) ─────────────────────────────────────────
# Задаются в Vercel → Settings → Environment Variables, не в файле.
# Браузер их не видит: запрос в Google делает сервер, а не устройство.
# Так CRM работает там, где script.googleusercontent.com не открывается.

SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/…/exec
SHEETS_SECRET=свойство SHARED_SECRET из настроек скрипта
CRM_PASSWORD=пароль входа в CRM, придумывается владельцем

# ── ИИ-чат в CRM ───────────────────────────────────────────────────
# Провайдер выбирается автоматически: если задан GEMINI_API_KEY - Gemini,
# иначе Anthropic. Можно указать явно через AI_PROVIDER.
#
# gemini    - бесплатный тариф Google AI Studio. Для пользователей ЕЭЗ,
#             Швейцарии и Великобритании данные не идут на обучение.
# anthropic - платный, по кредитам console.anthropic.com.
# openai    - любой OpenAI-совместимый: NVIDIA NIM, Groq, OpenRouter,
#             DeepSeek. Адрес задаётся через AI_API_URL.
#             ВНИМАНИЕ: бесплатный NVIDIA NIM разрешён только для
#             разработки и оценки, не для боевой работы.

GEMINI_API_KEY=ключ из aistudio.google.com
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=ключ Anthropic, если AI_PROVIDER=anthropic
# OPENAI_API_KEY=ключ, если AI_PROVIDER=openai
# AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
